# Chave que protege a API. Envie no header: X-API-Key: <valor>
# Deixe vazio só para testar localmente.
API_KEY=troque-por-uma-chave-secreta

# Origens permitidas no CORS (separadas por vírgula). Ex.: http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Mercado Livre (site MLB = Brasil). O token OAuth é necessário para a busca.
ML_COUNTRY=MLB
ML_ACCESS_TOKEN=

# WhatsApp via Evolution API
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-key
EVOLUTION_INSTANCE=promohunter
WHATSAPP_DEFAULT_NUMBER=5562999999999
WHATSAPP_DEFAULT_GROUP_ID=

# Pasta onde ficam config.json e enviados.json
DATA_DIR=data
# Horas antes de uma mesma oferta poder ser reenviada
REENVIO_HORAS=24
