# Chave que protege a API. Envie no header: X-API-Key: <valor>
# O PromoHunter.exe gera uma sozinho na primeira vez.
API_KEY=troque-por-uma-chave-secreta

# Origens permitidas no CORS (separadas por vírgula). Ex.: http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---- Onde buscar ----------------------------------------------------------------

# Google Shopping (todas as lojas) via SerpApi: https://serpapi.com (grátis: 250 buscas/mês)
SERPAPI_KEY=

# Shopee Afiliados (https://affiliate.shopee.com.br -> Open API). Links viram links de afiliado.
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Mercado Livre (site MLB = Brasil). Token OAuth da sua aplicação de desenvolvedor.
ML_COUNTRY=MLB
ML_ACCESS_TOKEN=

# ---- Onde postar as promoções ---------------------------------------------------

# Telegram: token do robô (criado no @BotFather) e o canal, ex.: @minhas_promocoes
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Outros ---------------------------------------------------------------------

# Pasta onde ficam config.json e enviados.json
DATA_DIR=data
# Horas antes de uma mesma oferta poder ser postada de novo
REENVIO_HORAS=24
